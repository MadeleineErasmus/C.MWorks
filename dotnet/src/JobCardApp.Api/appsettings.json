{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "SqlServer"
  },
  "Billing": {
    "TaxRate": 0.15,
    "PaymentTermDays": 30,
    "DefaultCallOutFee": 500.00,
    "QuoteValidDays": 30
  },
  "Jwt": {
    "_comment": "DEV ONLY. Move Key to user-secrets or an environment variable before any real deployment — never commit a production signing key.",
    "Key": "dev-only-signing-key-change-me-before-deployment-32chars-min",
    "Issuer": "JobCardApp.Api",
    "Audience": "JobCardApp.Mobile",
    "ExpiryMinutes": 480,
    "RememberMeExpiryMinutes": 43200
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=jobcards.db",
    "SqlServer": "Server=localhost;Database=JobCardApp;Trusted_Connection=True;TrustServerCertificate=True"
  }
}
