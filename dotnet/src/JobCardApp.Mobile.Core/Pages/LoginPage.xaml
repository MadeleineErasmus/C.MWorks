<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JobCardApp.Mobile.ViewModels"
             x:Class="JobCardApp.Mobile.Pages.LoginPage"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="{StaticResource Surface}"
             Title="Sign in"
             Shell.NavBarIsVisible="False">

    <Grid VerticalOptions="Center" Padding="24">
        <Border Style="{StaticResource CardFrame}">
            <VerticalStackLayout Spacing="12">
                <Label Text="C&amp;M Works"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Brand}"
                       HorizontalOptions="Center" />

                <Label Text="{Binding Error}"
                       TextColor="#B00020"
                       IsVisible="{Binding Error, Converter={x:Static vm:NotNullConverter.Instance}}" />

                <Label Text="Username" Style="{StaticResource Caption}" />
                <Entry Text="{Binding Username}"
                       Placeholder="your username"
                       IsSpellCheckEnabled="False"
                       IsTextPredictionEnabled="False" />

                <Label Text="Password" Style="{StaticResource Caption}" />
                <Entry Text="{Binding Password}"
                       IsPassword="True" />

                <HorizontalStackLayout Spacing="8">
                    <CheckBox IsChecked="{Binding RememberMe}" />
                    <Label Text="Remember me" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

                <Button Text="Sign in"
                        Command="{Binding LoginCommand}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
