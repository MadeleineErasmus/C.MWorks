<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:JobCardApp.Shared.Models;assembly=JobCardApp.Shared"
             xmlns:vm="clr-namespace:JobCardApp.Mobile.ViewModels"
             x:Class="JobCardApp.Mobile.Pages.InvoiceListPage"
             x:DataType="vm:InvoiceListViewModel"
             BackgroundColor="{StaticResource Surface}"
             Title="Invoices">

    <Grid RowDefinitions="Auto,*" Padding="12" RowSpacing="10">

        <Border Grid.Row="0" Style="{StaticResource CardFrame}">
            <VerticalStackLayout>
                <Label Text="Outstanding" Style="{StaticResource Caption}" />
                <Label Text="{Binding OutstandingTotal, StringFormat='{0:C}'}"
                       FontSize="26"
                       FontAttributes="Bold" />
            </VerticalStackLayout>
        </Border>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Invoices}">
                <CollectionView.EmptyView>
                    <Label Text="No invoices yet. Create one from a completed job card."
                           HorizontalOptions="Center"
                           Margin="0,40"
                           Style="{StaticResource Caption}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Invoice">
                        <Border Style="{StaticResource CardFrame}" Margin="0,0,0,10">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding Number}"
                                       FontAttributes="Bold" />
                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding Status}"
                                       Style="{StaticResource Caption}" />

                                <Label Grid.Row="1" Grid.ColumnSpan="2"
                                       Text="{Binding Customer.Name}"
                                       Style="{StaticResource Caption}" />

                                <Label Grid.Row="2" Grid.Column="0"
                                       Text="{Binding Total, StringFormat='Total {0:C} incl. VAT'}" />

                                <Button Grid.Row="2" Grid.Column="1"
                                        Text="Mark paid"
                                        FontSize="12"
                                        HeightRequest="34"
                                        Padding="10,0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InvoiceListViewModel}}, Path=MarkPaidCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
