<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:JobCardApp.Shared.Models;assembly=JobCardApp.Shared"
             xmlns:vm="clr-namespace:JobCardApp.Mobile.ViewModels"
             x:Class="JobCardApp.Mobile.Pages.CustomerItemHistoryPage"
             x:DataType="vm:CustomerItemHistoryViewModel"
             BackgroundColor="{StaticResource Surface}"
             Title="Item history">

    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="12">

            <Label Text="{Binding ItemName}" FontAttributes="Bold" FontSize="18" />

            <Label Text="{Binding Error}"
                   TextColor="#B00020"
                   IsVisible="{Binding Error, Converter={x:Static vm:NotNullConverter.Instance}}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <CollectionView ItemsSource="{Binding Entries}">
                        <CollectionView.EmptyView>
                            <Label Text="No recorded changes for this item yet."
                                   Style="{StaticResource Caption}"
                                   Margin="0,10" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CustomerItemHistoryEntry">
                                <VerticalStackLayout Padding="0,8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding Description}" FontAttributes="Bold" />
                                        <Label Grid.Column="1" Text="{Binding LineTotal, StringFormat='{0:C}'}" FontAttributes="Bold" />
                                    </Grid>
                                    <Label Style="{StaticResource Caption}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Date, StringFormat='{0:d}'}" />
                                                <Span Text=" · " />
                                                <Span Text="{Binding JobCardReference}" />
                                                <Span Text=" — " />
                                                <Span Text="{Binding JobCardTitle}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Style="{StaticResource Caption}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Kind}" />
                                                <Span Text=" · qty " />
                                                <Span Text="{Binding Quantity}" />
                                                <Span Text=" × " />
                                                <Span Text="{Binding UnitPrice, StringFormat='{0:C}'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="0,8,0,0" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
