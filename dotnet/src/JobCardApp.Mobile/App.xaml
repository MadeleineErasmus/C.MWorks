<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobCardApp.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Brand">#1F6F6B</Color>
            <Color x:Key="BrandDark">#134B48</Color>
            <Color x:Key="Muted">#6B7B7A</Color>
            <Color x:Key="Surface">#F5F7F6</Color>

            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Brand}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HeightRequest" Value="46" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style x:Key="CardFrame" TargetType="Border">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="#E2E8E7" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            </Style>

            <Style x:Key="Caption" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Muted}" />
                <Setter Property="FontSize" Value="12" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
