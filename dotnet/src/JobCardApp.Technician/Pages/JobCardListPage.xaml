<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:JobCardApp.Shared.Models;assembly=JobCardApp.Shared"
             xmlns:vm="clr-namespace:JobCardApp.Mobile.ViewModels"
             xmlns:conv="clr-namespace:JobCardApp.Mobile.ViewModels;assembly=JobCardApp.Mobile.Core"
             x:Class="JobCardApp.Mobile.Pages.JobCardListPage"
             x:DataType="vm:JobCardListViewModel"
             BackgroundColor="{StaticResource Surface}"
             Title="Job cards">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Logout" Command="{Binding LogoutCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="12" RowSpacing="10">

        <Label Grid.Row="0"
               Text="{Binding SignedInAs}"
               Style="{StaticResource Caption}"
               IsVisible="{Binding SignedInAs, Converter={x:Static conv:NotNullConverter.Instance}}" />

        <Picker Grid.Row="1"
                ItemsSource="{Binding StatusFilterOptions}"
                ItemDisplayBinding="{Binding Label}"
                SelectedItem="{Binding SelectedStatusFilter}" />

        <Label Grid.Row="2"
               Text="{Binding Error}"
               TextColor="#B00020"
               IsVisible="{Binding Error, Converter={x:Static conv:NotNullConverter.Instance}}" />

        <RefreshView Grid.Row="3"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding JobCards}">
                <CollectionView.EmptyView>
                    <Label Text="No job cards yet. Tap + New job card."
                           HorizontalOptions="Center"
                           Margin="0,40"
                           Style="{StaticResource Caption}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:JobCard">
                        <Border Style="{StaticResource CardFrame}" Margin="0,0,0,10">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding Title}"
                                       FontAttributes="Bold"
                                       FontSize="16" />
                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding Status}"
                                       Style="{StaticResource Caption}" />

                                <Label Grid.Row="1" Grid.ColumnSpan="2"
                                       Text="{Binding Customer.Name}"
                                       Style="{StaticResource Caption}" />

                                <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="12">
                                    <Label Text="{Binding Reference}" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding Subtotal, StringFormat='Subtotal {0:C}'}"
                                           Style="{StaticResource Caption}" />
                                </HorizontalStackLayout>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:JobCardListViewModel}}, Path=OpenJobCardCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Button Grid.Row="4"
                Text="+ New job card"
                Command="{Binding NewJobCardCommand}" />
    </Grid>
</ContentPage>
