<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobCardApp.Admin.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Brand">#5B3A99</Color>
            <Color x:Key="BrandDark">#3D2670</Color>
            <Color x:Key="Muted">#7D6F94</Color>
            <Color x:Key="Surface">#F7F5FB</Color>
            <Color x:Key="Border">#E4DEEF</Color>

            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Brand}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HeightRequest" Value="46" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style x:Key="CardFrame" TargetType="Border">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="{StaticResource Border}" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            </Style>

            <Style x:Key="Caption" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Muted}" />
                <Setter Property="FontSize" Value="12" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
